# ─────────────────────────────────────────────────────
# Copy this to .env.local for local development
# Set these in Vercel Dashboard → Project → Settings → Environment Variables for production
# ─────────────────────────────────────────────────────

# Vercel Postgres — auto-populated when you link a Vercel Postgres DB
POSTGRES_URL=

# Resend — get free API key at resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxx

# Your email to receive enquiry notifications
NOTIFY_EMAIL=vishwa.m1688@gmail.com

# Admin token — used to access GET /api/enquiries?token=...
# Generate a strong random string: openssl rand -hex 32
ADMIN_TOKEN=

# Setup token — used once to run /api/setup?token=...
SETUP_TOKEN=

# CORS — your production domain
ALLOWED_ORIGIN=https://skearecaplates.com
